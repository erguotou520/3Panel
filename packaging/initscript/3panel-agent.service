[Unit]
Description=3Panel Agent, the host-level service of 3Panel
After=syslog.target network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/3panel-agent
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
LimitNOFILE=1048576
LimitNPROC=1048576
LimitCORE=1048576
Delegate=yes
KillMode=process

[Install]
WantedBy=multi-user.target
