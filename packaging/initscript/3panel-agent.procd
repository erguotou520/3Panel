#!/bin/sh /etc/rc.common

### BEGIN INIT INFO
# Provides:          3panel-agentd
# Required-Start:    $network $local_fs
# Required-Stop:     $network $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: 3Panel Agent Daemon
# Description:       3Panel agent management daemon
### END INIT INFO

NAME="3panel-agentd"
DAEMON="/usr/local/bin/3panel-agent"

USE_PROCD=1
START=96
STOP=15
start_service() {
    procd_open_instance
    procd_set_param command "$DAEMON"
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
