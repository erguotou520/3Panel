{
    "name": "appstore-mirror",
    "private": true,
    "type": "module",
    "description": "Mirror the upstream 1Panel app store into Cloudsmith Generic",
    "scripts": {
        "sync": "node mirror.mjs",
        "sync:force": "node mirror.mjs --force",
        "dry-run": "node mirror.mjs --dry-run",
        "verify": "node mirror.mjs --verify-only"
    },
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.700.0"
    }
}
