# ---------------------------------------------------------------------------
# R2 credentials
#
# Create them in the Cloudflare dashboard:
#   R2 -> API -> Manage API Tokens -> Create API Token
#   Permission: "Object Read & Write", scoped to the bucket below.
# The account id is on the R2 overview page (also visible in the dashboard url).
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=appstore

# ---------------------------------------------------------------------------
# What to mirror
# ---------------------------------------------------------------------------

# Must match `base.mode` in the panel's /opt/3panel/conf/app.yaml.
# Upstream only serves dev and stable (200); beta and prod return 403, do not use them.
# The upstream layout uses 1panel, the panel asks for 3panel — the script renames while mirroring.
MODE=dev

# Upstream store. Leave as is.
SRC_ORIGIN=https://apps.1panel.pro

# Public url of your bucket (custom domain or r2.dev), https, no trailing slash.
# This is the value that ends up inside the store JSON, so it must be the one the panel uses
# (i.e. what AppRepoURL() returns: https://3panel.erguotou.me).
DST_ORIGIN=https://3panel.erguotou.me

# Mirror the *.tar.gz app packages too (~1400 files, ~0.7 GB total).
# Set to false only if your bucket already holds them and you just want to fix the small files.
SYNC_APP_PACKAGES=true

# Mirror data.yml per version (not fetched over HTTP by the panel, kept for layout parity).
SYNC_DATA_YML=true

# Parallel requests. The upstream throttles bursts with 403/429; lower this if you see retries.
CONCURRENCY=6
