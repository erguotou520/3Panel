dist/
# These are release artifacts that the upstream packaging flow drops at the
# repository ROOT. The leading slash is required: as bare filenames they also
# matched packaging/3pctl, packaging/install.sh and packaging/quick_start.sh,
# silently keeping the release tooling out of version control. (quick_start.sh
# was still bare until 2026-09-18 — a new packaging/quick_start.sh was invisible
# to `git status`, so the publish-bootstrap workflow would have found no file.)
/3pctl
/3panel.service
/install.sh
/quick_start.sh
cmd/server/fileList.txt
.fileList.txt
3Panel.code-workspace

core/.golangci.yml
agent/.golangci.yml

# Node
node_modules/

# Local-only credentials and state for the mirror tooling under scripts/.
# `.env.example` is a template and stays tracked; wrangler dev writes .wrangler/
# and the mirror scripts keep their resume state next to their config.
.env
.env.local
.dev.vars
.wrangler/
scripts/**/.mirror-state.json

.opencode
openspec
CLAUDE.md
AGENTS.md
opencode.json
superpowers
